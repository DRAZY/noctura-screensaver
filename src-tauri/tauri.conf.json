{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctura",
  "version": "0.7.0",
  "identifier": "com.noctura.screensaver",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noctura",
        "width": 800,
        "height": 600,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "../assets/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 290
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 290
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQURENUJDNENBRjMyMDcKUldRSE1xOU12Tld0VzlYS0sxS3d6NXJDUzJxeFlVeG1RR0hjVXRWb0RmY3gzd0ZER0FzNEFKNHkK",
      "endpoints": [
        "https://github.com/DRAZY/noctura-screensaver/releases/latest/download/latest.json"
      ]
    }
  }
}